ULTRA_RUNTIME_MODE=development
ULTRA_SERVER_PORT=7777

# Production requires all four settings below. Generate independent random
# values of at least 32 bytes; do not reuse the examples or commit real values.
DATABASE_URL=postgresql://ultra:CHANGE_ME@127.0.0.1:5432/ultra
REDIS_URL=redis://127.0.0.1:6379/0
ULTRA_ADMIN_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
ULTRA_RECOVERY_HMAC_KEY=CHANGE_ME_DIFFERENT_32_RANDOM_BYTES

SC_RECOVERY_WINDOW_SEC=60
