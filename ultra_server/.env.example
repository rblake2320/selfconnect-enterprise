ULTRA_RUNTIME_MODE=development
ULTRA_SERVER_PORT=7777

# Production requires all four settings below. Generate independent random
# values of at least 32 bytes; do not reuse the examples or commit real values.
DATABASE_URL=postgresql://ultra:CHANGE_ME@127.0.0.1:5432/ultra
REDIS_URL=redis://127.0.0.1:6379/0
ULTRA_ADMIN_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
# Set only during a bounded rolling rotation, then remove after clients drain.
ULTRA_ADMIN_TOKEN_PREVIOUS=
# Dedicated read-only credential accepted only by GET /metrics. Never reuse the
# admin token. Set the previous value only during a bounded scraper rotation.
ULTRA_METRICS_TOKEN=CHANGE_ME_DIFFERENT_32_RANDOM_BYTES
ULTRA_METRICS_TOKEN_PREVIOUS=
ULTRA_RECOVERY_HMAC_KEY=CHANGE_ME_DIFFERENT_32_RANDOM_BYTES
# Set only during a bounded rolling rotation, then remove after the token TTL.
ULTRA_RECOVERY_HMAC_KEY_PREVIOUS=

# Shared-state active/passive Ultra node fencing. Disabled by default. When
# enabled, every node starts non-writable and requires a fresh guard-signed
# activate/promote command. Each cluster needs a distinct guard secret.
ULTRA_HA_ENABLED=false
ULTRA_HA_CLUSTER_ID=CHANGE_ME_CLUSTER_ID
ULTRA_HA_NODE_ID=CHANGE_ME_NODE_ID
ULTRA_HA_NODE_ROLE=primary
ULTRA_HA_GUARD_SECRET=CHANGE_ME_DIFFERENT_32_RANDOM_BYTES
ULTRA_HA_MAX_COMMAND_AGE_MS=60000
ULTRA_HA_MAX_LEASE_MS=300000
ULTRA_HA_MIN_LEASE_REMAINING_MS=5000

SC_RECOVERY_WINDOW_SEC=60

# BPC sliding-window limits. Production stores these counters in Redis.
BPC_RATE_LIMIT_WINDOW_MS=60000
BPC_IP_RATE_LIMIT=200
BPC_PAIR_RATE_LIMIT=100
