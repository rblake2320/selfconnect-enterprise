{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "Ultra Server",
  "uid": "ultra-server",
  "tags": ["ultra", "selfconnect"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "15s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (by route)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "ultra-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (route) (rate(ultra_http_requests_total[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Auth failure rate (by reason)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "ultra-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (reason) (rate(ultra_auth_failures_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "TSK provisioning rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "ultra-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(ultra_tsk_provisions_total[5m])",
          "legendFormat": "tsk provisions/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "BPC registration rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "ultra-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(ultra_bpc_registrations_total[5m])",
          "legendFormat": "bpc registrations/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Process memory (resident + heap used)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "ultra-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "ultra_node_process_resident_memory_bytes",
          "legendFormat": "resident",
          "refId": "A"
        },
        {
          "expr": "ultra_node_nodejs_heap_size_used_bytes",
          "legendFormat": "heap used",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Process CPU",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "ultra-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(ultra_node_process_cpu_seconds_total[5m])",
          "legendFormat": "cpu cores",
          "refId": "A"
        }
      ]
    }
  ]
}
